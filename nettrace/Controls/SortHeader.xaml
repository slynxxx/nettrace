<UserControl
    x:Class="NetTrace.Controls.SortHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SortStates">
                <VisualState x:Name="Inactive" />
                <VisualState x:Name="Active">
                    <VisualState.Setters>
                        <Setter Target="LabelText.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                        <Setter Target="Chevron.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Button
            x:Name="HeaderButton"
            Style="{StaticResource SubtleButtonStyle}"
            Padding="4,3,4,3"
            Margin="-4,0,0,0"
            HorizontalAlignment="Left"
            Click="OnClick">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock
                    x:Name="LabelText"
                    FontSize="11"
                    FontWeight="Medium"
                    CharacterSpacing="30"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextSecondaryBrush}" />
                <FontIcon
                    x:Name="Chevron"
                    Style="{StaticResource IconStyle}"
                    FontSize="9"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    Visibility="Collapsed" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
