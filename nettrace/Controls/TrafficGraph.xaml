<UserControl
    x:Class="NetTrace.Controls.TrafficGraph"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="PlotArea" SizeChanged="OnPlotSizeChanged" Background="Transparent">
            <Line x:Name="GridTop" Stroke="{ThemeResource GraphGridBrush}" StrokeThickness="1" />
            <Line x:Name="GridMiddle" Stroke="{ThemeResource GraphGridBrush}" StrokeThickness="1" StrokeDashArray="2,3" />
            <Line x:Name="GridBottom" Stroke="{ThemeResource BorderStrongBrush}" StrokeThickness="1" />

            <Polyline x:Name="UploadLine" Stroke="{ThemeResource GraphSecondaryBrush}" StrokeThickness="1.25" StrokeLineJoin="Round" />
            <Polyline x:Name="DownloadLine" Stroke="{ThemeResource GraphPrimaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" />

            <TextBlock x:Name="MaxLabel" Style="{StaticResource TertiaryTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" />
            <TextBlock x:Name="MidLabel" Style="{StaticResource TertiaryTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <TextBlock x:Name="WaitingLabel" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="collecting samples…" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,6,0,0">
            <TextBlock x:Name="StartLabel" Style="{StaticResource TertiaryTextStyle}" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource TertiaryTextStyle}" HorizontalAlignment="Right" Text="now" />
        </Grid>
    </Grid>
</UserControl>
