<?xml version="1.0" encoding="utf-8"?>
<views:HostedPage
    x:Class="NetTrace.Views.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NetTrace.Views"
    xmlns:controls="using:NetTrace.Controls"
    xmlns:vm="using:NetTrace.ViewModels">

    <Page.Resources>
        <MenuFlyout x:Key="RowMenu" Opening="OnRowMenuOpening">
            <MenuFlyoutItem Text="copy row" Click="OnCopyRow">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="copy local address" Click="OnCopyLocal" />
            <MenuFlyoutItem Text="copy remote address" Click="OnCopyRemote" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="look up remote address" Click="OnLookupRemote">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="show process" Click="OnShowProcess">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xECAA;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid Padding="32,4,32,20" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Margin="0,0,0,20">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="connections" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="refresh now (f5)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Style="{StaticResource IconStyle}" Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="refresh" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- filters -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,14">
            <TextBox Style="{StaticResource SearchBoxStyle}"
                     Width="320"
                     PlaceholderText="search address, port, process, state or pid"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                      ItemsSource="{x:Bind ViewModel.ProtocolFilters}"
                      SelectedIndex="{x:Bind ViewModel.ProtocolFilterIndex, Mode=TwoWay}" />
            <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                      ItemsSource="{x:Bind ViewModel.StateFilters}"
                      SelectedIndex="{x:Bind ViewModel.StateFilterIndex, Mode=TwoWay}" />
            <CheckBox Content="hide loopback" FontSize="12" MinWidth="0" Margin="8,0,0,0"
                      IsChecked="{x:Bind ViewModel.HideLoopback, Mode=TwoWay}" />
        </StackPanel>

        <!-- error -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
            <FontIcon Style="{StaticResource IconStyle}" Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource TextPrimaryBrush}" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />
        </StackPanel>

        <!-- column headers -->
        <Border Grid.Row="3" Style="{StaticResource TableHeaderBorderStyle}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="132" />
                </Grid.ColumnDefinitions>
                <controls:SortHeader Grid.Column="0" Label="protocol" Column="protocol" ActiveColumn="{x:Bind ViewModel.SortColumn, Mode=OneWay}" Descending="{x:Bind ViewModel.SortDescending, Mode=OneWay}" Command="{x:Bind ViewModel.SortCommand}" />
                <controls:SortHeader Grid.Column="1" Label="local" Column="local" ActiveColumn="{x:Bind ViewModel.SortColumn, Mode=OneWay}" Descending="{x:Bind ViewModel.SortDescending, Mode=OneWay}" Command="{x:Bind ViewModel.SortCommand}" />
                <controls:SortHeader Grid.Column="2" Label="remote" Column="remote" ActiveColumn="{x:Bind ViewModel.SortColumn, Mode=OneWay}" Descending="{x:Bind ViewModel.SortDescending, Mode=OneWay}" Command="{x:Bind ViewModel.SortCommand}" />
                <controls:SortHeader Grid.Column="3" Label="state" Column="state" ActiveColumn="{x:Bind ViewModel.SortColumn, Mode=OneWay}" Descending="{x:Bind ViewModel.SortDescending, Mode=OneWay}" Command="{x:Bind ViewModel.SortCommand}" />
                <controls:SortHeader Grid.Column="4" Label="process" Column="process" ActiveColumn="{x:Bind ViewModel.SortColumn, Mode=OneWay}" Descending="{x:Bind ViewModel.SortDescending, Mode=OneWay}" Command="{x:Bind ViewModel.SortCommand}" />
                <controls:SortHeader Grid.Column="5" Label="pid" Column="pid" ActiveColumn="{x:Bind ViewModel.SortColumn, Mode=OneWay}" Descending="{x:Bind ViewModel.SortDescending, Mode=OneWay}" Command="{x:Bind ViewModel.SortCommand}" />
                <controls:SortHeader Grid.Column="6" Label="first observed" Column="first" ActiveColumn="{x:Bind ViewModel.SortColumn, Mode=OneWay}" Descending="{x:Bind ViewModel.SortDescending, Mode=OneWay}" Command="{x:Bind ViewModel.SortCommand}" />
            </Grid>
        </Border>

        <!-- rows -->
        <ListView Grid.Row="4"
                  ItemsSource="{x:Bind ViewModel.Rows}"
                  SelectionMode="Single"
                  ItemContainerStyle="{StaticResource TableRowStyle}"
                  Visibility="{x:Bind ViewModel.ShowTable, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ConnectionRowViewModel">
                    <Grid Background="Transparent" ContextFlyout="{StaticResource RowMenu}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CellSecondaryTextStyle}" Text="{x:Bind Protocol}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource CellMonoTextStyle}" Text="{x:Bind LocalEndpoint}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource CellMonoTextStyle}" Text="{x:Bind RemoteEndpoint}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource CellSecondaryTextStyle}" Text="{x:Bind State, Mode=OneWay}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource CellTextStyle}" Text="{x:Bind ProcessName, Mode=OneWay}" />
                        <TextBlock Grid.Column="5" Style="{StaticResource CellSecondaryTextStyle}" Text="{x:Bind PidText, Mode=OneWay}" />
                        <TextBlock Grid.Column="6" Style="{StaticResource CellSecondaryTextStyle}" Text="{x:Bind FirstSeenText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:EmptyState Grid.Row="4"
                             IsLoading="True"
                             Title="reading endpoint tables"
                             Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <controls:EmptyState Grid.Row="4"
                             Glyph="&#xE71C;"
                             Title="no endpoints to show"
                             Message="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                             ActionText="clear filters"
                             ActionCommand="{x:Bind ViewModel.ClearFiltersCommand}"
                             Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" />
    </Grid>
</views:HostedPage>
