<?xml version="1.0" encoding="utf-8"?>
<views:HostedPage
    x:Class="NetTrace.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NetTrace.Views"
    xmlns:controls="using:NetTrace.Controls"
    xmlns:models="using:NetTrace.Models">

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,4,32,32" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Spacing="6" Margin="0,0,0,24">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="settings" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="changes are applied immediately and saved locally" />
            </StackPanel>

            <!-- monitoring -->
            <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="monitoring" Margin="0,0,0,4" />
            <controls:SettingRow Header="refresh interval" Description="how often the tcp and udp endpoint tables are read">
                <ComboBox Style="{StaticResource FilterComboBoxStyle}" MinWidth="180"
                          ItemsSource="{x:Bind ViewModel.RefreshOptions}"
                          SelectedIndex="{x:Bind ViewModel.RefreshIndex, Mode=TwoWay}" />
            </controls:SettingRow>
            <controls:SettingRow Header="traffic sampling interval" Description="how often interface byte counters are sampled for speed and the graph">
                <ComboBox Style="{StaticResource FilterComboBoxStyle}" MinWidth="180"
                          ItemsSource="{x:Bind ViewModel.SampleOptions}"
                          SelectedIndex="{x:Bind ViewModel.SampleIndex, Mode=TwoWay}" />
            </controls:SettingRow>
            <controls:SettingRow Header="network interface" Description="{x:Bind ViewModel.InterfaceSelector.Description, Mode=OneWay}">
                <ComboBox Style="{StaticResource FilterComboBoxStyle}" MinWidth="240" MaxWidth="320"
                          ItemsSource="{x:Bind ViewModel.InterfaceSelector.Interfaces}"
                          SelectedIndex="{x:Bind ViewModel.InterfaceSelector.SelectedIndex, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:NetworkInterfaceInfo">
                            <TextBlock Text="{x:Bind DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:SettingRow>

            <!-- history -->
            <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="history" Margin="0,28,0,4" />
            <controls:SettingRow Header="automatic history collection" Description="record every observed endpoint to the local sqlite database">
                <ToggleSwitch OnContent="on" OffContent="off" MinWidth="0" FontSize="12"
                              IsOn="{x:Bind ViewModel.HistoryEnabled, Mode=TwoWay}" />
            </controls:SettingRow>
            <controls:SettingRow Header="history retention" Description="records older than this are removed automatically">
                <ComboBox Style="{StaticResource FilterComboBoxStyle}" MinWidth="180"
                          ItemsSource="{x:Bind ViewModel.RetentionOptions}"
                          SelectedIndex="{x:Bind ViewModel.RetentionIndex, Mode=TwoWay}" />
            </controls:SettingRow>
            <controls:SettingRow Header="data location" Description="{x:Bind ViewModel.DataDirectory}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Text="{x:Bind ViewModel.DatabaseText, Mode=OneWay}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.CopyDataFolderCommand}" ToolTipService.ToolTip="copy path">
                        <FontIcon Style="{StaticResource IconStyle}" Glyph="&#xE8C8;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Content="open folder" Command="{x:Bind ViewModel.OpenDataFolderCommand}" />
                </StackPanel>
            </controls:SettingRow>

            <!-- appearance -->
            <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="appearance" Margin="0,28,0,4" />
            <controls:SettingRow Header="theme" Description="monochrome dark or light">
                <ComboBox Style="{StaticResource FilterComboBoxStyle}" MinWidth="180"
                          ItemsSource="{x:Bind ViewModel.Themes}"
                          SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" />
            </controls:SettingRow>
            <controls:SettingRow Header="startup page" Description="the page shown when nettrace opens">
                <ComboBox Style="{StaticResource FilterComboBoxStyle}" MinWidth="180"
                          ItemsSource="{x:Bind ViewModel.StartupPages}"
                          SelectedIndex="{x:Bind ViewModel.StartupPageIndex, Mode=TwoWay}" />
            </controls:SettingRow>

            <!-- about -->
            <TextBlock Style="{StaticResource SectionLabelTextStyle}" Text="about" Margin="0,28,0,4" />
            <controls:SettingRow Header="nettrace" Description="passive local network monitor. no telemetry, no packet capture, no firewall changes. history and settings never leave this device.">
                <TextBlock Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center">
                    <Run Text="version" /> <Run Text="{x:Bind ViewModel.Version}" />
                </TextBlock>
            </controls:SettingRow>
        </StackPanel>
    </ScrollViewer>
</views:HostedPage>
