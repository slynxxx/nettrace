<?xml version="1.0" encoding="utf-8"?>
<views:HostedPage
    x:Class="NetTrace.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NetTrace.Views"
    xmlns:controls="using:NetTrace.Controls"
    xmlns:vm="using:NetTrace.ViewModels">

    <Grid Padding="32,4,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Margin="0,0,0,20">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="processes" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Style="{StaticResource IconStyle}" Glyph="&#xE72C;" FontSize="12" />
                    <TextBlock Text="refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
            <FontIcon Style="{StaticResource IconStyle}" Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource TextPrimaryBrush}" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- process list -->
            <Grid BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource SearchBoxStyle}"
                             PlaceholderText="search"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Column="1"
                              Style="{StaticResource FilterComboBoxStyle}"
                              MinWidth="0"
                              ItemsSource="{x:Bind ViewModel.SortOptions}"
                              SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" />
                </Grid>

                <ListView Grid.Row="1"
                          x:Name="ProcessList"
                          ItemsSource="{x:Bind ViewModel.Processes}"
                          SelectionMode="Single"
                          SelectionChanged="OnProcessSelectionChanged"
                          ItemContainerStyle="{StaticResource ListRowStyle}"
                          Visibility="{x:Bind ViewModel.ShowList, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProcessRowViewModel">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="{x:Bind Name}" />
                                    <TextBlock Style="{StaticResource TertiaryTextStyle}">
                                        <Run Text="pid" /> <Run Text="{x:Bind PidText}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind ConnectionCountText, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <controls:EmptyState Grid.Row="1" IsLoading="True" Title="reading endpoint tables" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <controls:EmptyState Grid.Row="1" Glyph="&#xE721;" Title="no matching processes" Message="no process that owns an endpoint matches the search" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" />
            </Grid>

            <!-- details -->
            <Grid Grid.Column="1" Padding="24,0,0,0" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource PageTitleTextStyle}" FontSize="17" Text="{x:Bind ViewModel.SelectedProcess.Name, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}">
                            <Run Text="pid" /> <Run Text="{x:Bind ViewModel.SelectedProcess.PidText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource CellMonoTextStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   Margin="0"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Text="{x:Bind ViewModel.SelectedProcess.PathText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.CopyPathCommand}" IsEnabled="{x:Bind ViewModel.SelectedProcess.HasPath, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Style="{StaticResource IconStyle}" Glyph="&#xE8C8;" FontSize="12" />
                                <TextBlock Text="copy path" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.ShowInConnectionsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Style="{StaticResource IconStyle}" Glyph="&#xE839;" FontSize="12" />
                                <TextBlock Text="show in connections" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,24,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:StatItem Grid.Column="0" Label="endpoints" Value="{x:Bind ViewModel.SelectedProcess.ConnectionCountText, Mode=OneWay}" />
                    <controls:StatItem Grid.Column="1" Label="tcp" Value="{x:Bind vm:Format.Number(ViewModel.SelectedProcess.TcpCount), Mode=OneWay}" />
                    <controls:StatItem Grid.Column="2" Label="udp" Value="{x:Bind vm:Format.Number(ViewModel.SelectedProcess.UdpCount), Mode=OneWay}" />
                    <controls:StatItem Grid.Column="3" Label="established" Value="{x:Bind vm:Format.Number(ViewModel.SelectedProcess.EstablishedCount), Mode=OneWay}" />
                    <controls:StatItem Grid.Column="4" Label="listening" Value="{x:Bind vm:Format.Number(ViewModel.SelectedProcess.ListeningCount), Mode=OneWay}" />
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource TableHeaderBorderStyle}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" Text="protocol" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" Text="local" />
                        <TextBlock Grid.Column="2" Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" Text="remote" />
                        <TextBlock Grid.Column="3" Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" Text="state" />
                        <TextBlock Grid.Column="4" Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" Text="first observed" />
                    </Grid>
                </Border>

                <ListView Grid.Row="3"
                          ItemsSource="{x:Bind ViewModel.SelectedConnections}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource TableRowStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConnectionRowViewModel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="132" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CellSecondaryTextStyle}" Text="{x:Bind Protocol}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource CellMonoTextStyle}" Text="{x:Bind LocalEndpoint}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource CellMonoTextStyle}" Text="{x:Bind RemoteEndpoint}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource CellSecondaryTextStyle}" Text="{x:Bind State, Mode=OneWay}" />
                                <TextBlock Grid.Column="4" Style="{StaticResource CellSecondaryTextStyle}" Text="{x:Bind FirstSeenText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <controls:EmptyState Grid.Column="1"
                                 Glyph="&#xECAA;"
                                 Title="select a process"
                                 Message="choose a process on the left to inspect its endpoints"
                                 Visibility="{x:Bind ViewModel.ShowNoSelection, Mode=OneWay}" />
        </Grid>
    </Grid>
</views:HostedPage>
