<?xml version="1.0" encoding="utf-8"?>
<views:HostedPage
    x:Class="NetTrace.Views.DnsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NetTrace.Views"
    xmlns:controls="using:NetTrace.Controls"
    xmlns:models="using:NetTrace.Models">

    <Grid Padding="32,4,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6" Margin="0,0,0,20">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="dns lookup" />
            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="resolve host names and ptr records through the system resolver" />
        </StackPanel>

        <!-- query -->
        <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="460" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox"
                     Style="{StaticResource SearchBoxStyle}"
                     PlaceholderText="host name or ip address, e.g. example.com or 1.1.1.1"
                     Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnQueryKeyDown" />
            <ComboBox Grid.Column="1" Style="{StaticResource FilterComboBoxStyle}" MinWidth="110"
                      ItemsSource="{x:Bind ViewModel.Modes}"
                      SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}" />
            <ComboBox Grid.Column="2" Style="{StaticResource FilterComboBoxStyle}"
                      ItemsSource="{x:Bind ViewModel.Families}"
                      SelectedIndex="{x:Bind ViewModel.FamilyIndex, Mode=TwoWay}"
                      IsEnabled="{x:Bind ViewModel.IsFamilyEnabled, Mode=OneWay}" />
            <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}" MinHeight="30" FontSize="12" Padding="16,5,16,6"
                    Content="look up"
                    Command="{x:Bind ViewModel.LookupCommand}" />
            <Button Grid.Column="4" Style="{StaticResource SubtleButtonStyle}" Content="cancel"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- result -->
            <Grid Padding="0,0,24,0">
                <Grid Visibility="{x:Bind ViewModel.ShowResult, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource BodyTextStyle}" FontSize="15" FontWeight="SemiBold" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.ResultTitle, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.ResultDetails, Mode=OneWay}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.CopyAllCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Style="{StaticResource IconStyle}" Glyph="&#xE8C8;" FontSize="12" />
                                <TextBlock Text="copy all" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView Grid.Row="1"
                              x:Name="RecordList"
                              ItemsSource="{x:Bind ViewModel.Records}"
                              SelectionMode="None"
                              ItemContainerStyle="{StaticResource TableRowStyle}"
                              BorderBrush="{ThemeResource BorderSubtleBrush}"
                              BorderThickness="0,1,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DnsRecord">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CellSecondaryTextStyle}" Text="{x:Bind Type}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource CellMonoTextStyle}" IsTextSelectionEnabled="True" Text="{x:Bind Value}" />
                                    <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Padding="6,4,6,4"
                                            ToolTipService.ToolTip="copy"
                                            Click="OnCopyRecord" Tag="{x:Bind}">
                                        <FontIcon Style="{StaticResource IconStyle}" Glyph="&#xE8C8;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <controls:EmptyState Glyph="&#xE774;"
                                     Title="look up a name or an address"
                                     Message="forward lookups return a and aaaa records. reverse lookups return the ptr name of an ipv4 or ipv6 address."
                                     Visibility="{x:Bind ViewModel.ShowIdle, Mode=OneWay}" />
                <controls:EmptyState IsLoading="True"
                                     Title="resolving"
                                     Message="{x:Bind ViewModel.Query, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <controls:EmptyState Glyph="&#xE7BA;"
                                     Title="lookup failed"
                                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
            </Grid>

            <!-- recent -->
            <Grid Grid.Column="1" Padding="20,0,0,0" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" Text="recent lookups" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" Content="clear"
                            Command="{x:Bind ViewModel.ClearRecentCommand}"
                            Visibility="{x:Bind ViewModel.HasRecent, Mode=OneWay}" />
                </Grid>
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Recent}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnRecentClick"
                          ItemContainerStyle="{StaticResource ListRowStyle}"
                          Margin="-12,0,0,0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:DnsLookupResult">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="{x:Bind Query}" />
                                <TextBlock Style="{StaticResource TertiaryTextStyle}">
                                    <Run Text="{x:Bind ModeText}" /><Run Text="  ·  " /><Run Text="{x:Bind Summary}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="1" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"
                           Text="lookups you run appear here. results are cached for five minutes."
                           TextWrapping="Wrap" TextTrimming="None"
                           Visibility="{x:Bind ViewModel.HasRecent, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Grid>
    </Grid>
</views:HostedPage>
