<?xml version="1.0" encoding="utf-8"?>
<views:HostedPage
    x:Class="NetTrace.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NetTrace.Views"
    xmlns:controls="using:NetTrace.Controls"
    xmlns:models="using:NetTrace.Models">

    <Grid Padding="32,4,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Margin="0,0,0,20">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="history" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.IsAvailable}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Style="{StaticResource IconStyle}" Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="refresh" />
                    </StackPanel>
                </Button>
                <DropDownButton FontSize="12" MinHeight="30" Padding="10,5,8,6" IsEnabled="{x:Bind ViewModel.IsAvailable}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Style="{StaticResource IconStyle}" Glyph="&#xEDE1;" FontSize="12" />
                        <TextBlock Text="export" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="export as csv" Command="{x:Bind ViewModel.ExportCsvCommand}" />
                            <MenuFlyoutItem Text="export as json" Command="{x:Bind ViewModel.ExportJsonCommand}" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.ClearCommand}" IsEnabled="{x:Bind ViewModel.IsAvailable}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Style="{StaticResource IconStyle}" Glyph="&#xE74D;" FontSize="12" />
                        <TextBlock Text="clear" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- collection disabled -->
        <Grid Grid.Row="1" Margin="0,0,0,14" Padding="14,10,10,10"
              BorderBrush="{ThemeResource BorderStrongBrush}" BorderThickness="1" CornerRadius="3"
              Visibility="{x:Bind ViewModel.ShowCollectionOff, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Style="{StaticResource IconStyle}" Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Foreground="{ThemeResource TextPrimaryBrush}" Text="automatic history collection is off. new connections are not being recorded." VerticalAlignment="Center" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" Content="open settings" Command="{x:Bind ViewModel.OpenSettingsCommand}" />
        </Grid>

        <!-- filters -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBox Style="{StaticResource SearchBoxStyle}"
                     Width="320"
                     PlaceholderText="search process, address, state, port or pid"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                      ItemsSource="{x:Bind ViewModel.ProtocolFilters}"
                      SelectedIndex="{x:Bind ViewModel.ProtocolFilterIndex, Mode=TwoWay}" />
            <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                      ItemsSource="{x:Bind ViewModel.Ranges}"
                      SelectedIndex="{x:Bind ViewModel.RangeIndex, Mode=TwoWay}" />
        </StackPanel>

        <TextBlock Grid.Row="3" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,12"
                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}" />

        <!-- column headers -->
        <Border Grid.Row="4" Style="{StaticResource TableHeaderBorderStyle}" Visibility="{x:Bind ViewModel.ShowTable, Mode=OneWay}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" Text="process" />
                <TextBlock Grid.Column="1" Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" Text="protocol" />
                <TextBlock Grid.Column="2" Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" Text="local" />
                <TextBlock Grid.Column="3" Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" Text="remote" />
                <TextBlock Grid.Column="4" Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" Text="state" />
                <TextBlock Grid.Column="5" Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" Text="first observed" />
                <TextBlock Grid.Column="6" Style="{StaticResource SectionLabelTextStyle}" VerticalAlignment="Center" Text="last observed" />
            </Grid>
        </Border>

        <ListView Grid.Row="5"
                  ItemsSource="{x:Bind ViewModel.Records, Mode=OneWay}"
                  SelectionMode="Single"
                  ItemContainerStyle="{StaticResource TableRowStyle}"
                  Visibility="{x:Bind ViewModel.ShowTable, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:HistoryRecord">
                    <Grid Background="Transparent">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="copy record" Click="OnCopyRecord" Tag="{x:Bind}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CellTextStyle}" Text="{x:Bind ProcessText}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource CellSecondaryTextStyle}" Text="{x:Bind Protocol}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource CellMonoTextStyle}" Text="{x:Bind LocalEndpoint}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource CellMonoTextStyle}" Text="{x:Bind RemoteEndpoint}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource CellSecondaryTextStyle}" Text="{x:Bind State}" />
                        <TextBlock Grid.Column="5" Style="{StaticResource CellSecondaryTextStyle}" Text="{x:Bind FirstSeenText}" />
                        <TextBlock Grid.Column="6" Style="{StaticResource CellSecondaryTextStyle}" Text="{x:Bind LastSeenText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:EmptyState Grid.Row="5"
                             Glyph="&#xE81C;"
                             Title="no history to show"
                             Message="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                             ActionText="show all time"
                             ActionCommand="{x:Bind ViewModel.ClearFiltersCommand}"
                             Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" />
        <controls:EmptyState Grid.Row="5"
                             Glyph="&#xE7BA;"
                             Title="history unavailable"
                             Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
    </Grid>
</views:HostedPage>
